{
  "name": "mcsleepingserverstarter",
  "version": "2.0.0",
  "description": "Sleeps until someone connects",
  "main": "build/sleepingServerStarter.js",
  "bin": "build/sleepingServerStarter.js",
  "scripts": {
    "start": "npm run prebuild && npm run build:typescript && npm run run",
    "run": "node .",
    "dev": "cross-env disableFileLogs=true node --inspect=7000 -r ts-node/register ./src/sleepingServerStarter.ts ",
    "prebuild": "node -e \"const fs=require('node:fs'); for (const dir of ['build','bin']) fs.rmSync(dir,{recursive:true,force:true}); fs.cpSync('views','build/views',{recursive:true})\"",
    "build": "npm run build:typescript && npm run build:bin",
    "build:typescript": "tsc",
    "build:bin": "node scripts/build-sea.mjs",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\""
  },
  "dependencies": {
    "@sfirew/minecraft-motd-parser": "^1.1.6",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "js-yaml": "^4.1.0",
    "properties-reader": "^2.3.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/properties-reader": "^2.1.3",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "cross-env": "7.0.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29.7.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "author": "Vincss",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincss/mcsleepingserverstarter.git"
  },
  "keywords": [
    "maintenance",
    "minecraft",
    "nodejs",
    "emptyserverstopper",
    "sleepingserver"
  ],
  "bugs": {
    "url": "https://github.com/vincss/mcsleepingserverstarter/issues"
  },
  "homepage": "https://github.com/vincss/mcsleepingserverstarter#readme",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
